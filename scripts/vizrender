#!/usr/bin/env bash
# vizrender — Typst Render Engine (Layer 2)
# Compiles .typ files, optionally displays inline via vizshow
#
# Usage: vizrender <input.typ> [--format svg|png|pdf] [--no-display] [--output PATH]
#                               [--width N] [--open]
#
# Structured output:
#   [vizrender: input.typ → output.svg]
#   [vizrender: source=/abs/path/input.typ]
#   [vizrender: rendered=/abs/path/output.svg]
#   [vizrender: displayed=/abs/path/output.png]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TEMPLATE_DIR="$(cd "$SCRIPT_DIR/../templates" && pwd)"

# ── Defaults ──────────────────────────────────────────────────────────────
INPUT=""
FORMAT="svg"
DISPLAY=true
OUTPUT=""
WIDTH=""
OPEN=false

# ── Argument parsing ─────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --format)      FORMAT="$2";  shift 2 ;;
    --no-display)  DISPLAY=false; shift   ;;
    --display)     DISPLAY=true;  shift   ;;
    --output)      OUTPUT="$2";  shift 2 ;;
    --width)       WIDTH="$2";   shift 2 ;;
    --open)        OPEN=true;    shift   ;;
    -*)
      echo "vizrender: unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$INPUT" ]]; then
        INPUT="$1"
      else
        echo "vizrender: unexpected argument: $1" >&2
        exit 1
      fi
      shift
      ;;
  esac
done

# ── Validate input ────────────────────────────────────────────────────────
if [[ -z "$INPUT" ]]; then
  echo "vizrender: no input file specified" >&2
  exit 1
fi

if [[ ! -f "$INPUT" ]]; then
  echo "vizrender: not found: $INPUT" >&2
  exit 1
fi

# ── Resolve paths ─────────────────────────────────────────────────────────
ABS_INPUT="$(cd "$(dirname "$INPUT")" && pwd)/$(basename "$INPUT")"
BASENAME="$(basename "$INPUT" .typ)"
INPUT_DIR="$(dirname "$ABS_INPUT")"

# Determine output path
if [[ -n "$OUTPUT" ]]; then
  # If OUTPUT is relative, resolve against input directory
  if [[ "$OUTPUT" != /* ]]; then
    ABS_OUTPUT="$(cd "$INPUT_DIR" && pwd)/$OUTPUT"
  else
    ABS_OUTPUT="$OUTPUT"
  fi
  # Infer format from extension if --format wasn't explicitly set
  case "$ABS_OUTPUT" in
    *.png) [[ "$FORMAT" == "svg" ]] && FORMAT="png" ;;
    *.pdf) [[ "$FORMAT" == "svg" ]] && FORMAT="pdf" ;;
  esac
else
  ABS_OUTPUT="${INPUT_DIR}/${BASENAME}.${FORMAT}"
fi

# ── Compile ───────────────────────────────────────────────────────────────
if ! typst compile --input "template-dir=$TEMPLATE_DIR" "$ABS_INPUT" "$ABS_OUTPUT"; then
  echo "vizrender: typst compile failed" >&2
  exit 1
fi

# ── Prepare display file ─────────────────────────────────────────────────
DISPLAY_FILE=""

if [[ "$DISPLAY" == true ]] || [[ "$OPEN" == true ]]; then
  case "$FORMAT" in
    svg)
      # Convert SVG → PNG for terminal display
      DISPLAY_FILE="${INPUT_DIR}/${BASENAME}.png"
      if [[ -x /opt/homebrew/bin/rsvg-convert ]]; then
        /opt/homebrew/bin/rsvg-convert "$ABS_OUTPUT" -o "$DISPLAY_FILE"
      elif command -v magick &>/dev/null; then
        magick "$ABS_OUTPUT" "$DISPLAY_FILE"
      else
        # Fallback: compile directly to PNG via typst
        if ! typst compile --input "template-dir=$TEMPLATE_DIR" "$ABS_INPUT" "$DISPLAY_FILE"; then
          echo "vizrender: failed to create display PNG" >&2
          DISPLAY_FILE=""
        fi
      fi
      ;;
    png)
      DISPLAY_FILE="$ABS_OUTPUT"
      ;;
    pdf)
      # Convert PDF → PNG for display via typst compile
      DISPLAY_FILE="${INPUT_DIR}/${BASENAME}.png"
      if ! typst compile --input "template-dir=$TEMPLATE_DIR" "$ABS_INPUT" "$DISPLAY_FILE"; then
        echo "vizrender: failed to create display PNG from PDF" >&2
        DISPLAY_FILE=""
      fi
      ;;
  esac
fi

# ── Write watch file (before display, so vizwatch can pick it up) ────────
WATCH_DIR="${INLINE_VIZ_WATCH_DIR:-/tmp/inline-viz-watch}"
if [[ -n "$DISPLAY_FILE" ]] && [[ -f "$DISPLAY_FILE" ]]; then
  ABS_DISPLAY="$(cd "$(dirname "$DISPLAY_FILE")" && pwd)/$(basename "$DISPLAY_FILE")"
  mkdir -p "$WATCH_DIR"
  cat > "$WATCH_DIR/latest.json" << WATCHEOF
{"displayed":"$ABS_DISPLAY","source":"$ABS_INPUT","rendered":"$ABS_OUTPUT"}
WATCHEOF
fi

# ── Display ──────────────────────────────────────────────────────────────
if [[ -n "$DISPLAY_FILE" ]] && [[ -f "$DISPLAY_FILE" ]] && [[ "$DISPLAY" == true ]]; then
  if [[ "$OPEN" == true ]]; then
    open "$DISPLAY_FILE"
  elif [[ -n "${TMUX:-}" ]]; then
    # Inside tmux — open vizwatch in a split pane (auto-updates via watch dir)
    if ! tmux list-panes -F '#{pane_title}' 2>/dev/null | grep -q 'vizwatch'; then
      tmux split-window -h -l 40% \
        "${SCRIPT_DIR}/vizwatch" --mode terminal --clear \; \
        select-pane -T vizwatch \; \
        select-pane -l
      # Give vizwatch a moment to start polling
      sleep 0.5
    fi
  elif [[ -n "${ZELLIJ:-}" ]]; then
    # Inside zellij — open vizwatch in a floating pane
    if ! zellij action query-tab-names 2>/dev/null | grep -q 'vizwatch'; then
      zellij run --floating --name vizwatch -- \
        "${SCRIPT_DIR}/vizwatch" --mode terminal --clear &
      sleep 0.5
    fi
  else
    # Default: open in system viewer
    open "$DISPLAY_FILE"
  fi
fi

# ── Structured output ────────────────────────────────────────────────────
echo "[vizrender: $(basename "$ABS_INPUT") → $(basename "$ABS_OUTPUT")]"
echo "[vizrender: source=$ABS_INPUT]"
echo "[vizrender: rendered=$ABS_OUTPUT]"
if [[ -n "${ABS_DISPLAY:-}" ]]; then
  echo "[vizrender: displayed=$ABS_DISPLAY]"
fi
