#!/usr/bin/env python3
"""
vizwatch — image viewer for inline-viz.

Two modes:
  --mode browser   Floating browser window (default). Works everywhere.
  --mode terminal  Displays images in current terminal pane using
                   kitty/iTerm2 graphics protocol. Best for tmux/zellij
                   split panes where the terminal has direct access.

Usage:
    vizwatch                          # browser mode
    vizwatch --mode terminal          # terminal pane mode (for tmux/zellij)
    vizwatch --mode terminal --clear  # clear between updates
"""

import argparse
import http.server
import json
import os
import socketserver
import subprocess
import sys
import time
from pathlib import Path

WATCH_DIR = Path("/tmp/inline-viz-watch")
DEFAULT_PORT = 52342

HTML_PAGE = """<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>vizwatch</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #1a1a2e;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    font-family: -apple-system, sans-serif;
    color: #8b949e;
    overflow: hidden;
  }
  #status {
    position: fixed;
    top: 8px;
    right: 12px;
    font-size: 11px;
    opacity: 0.6;
  }
  #label {
    position: fixed;
    bottom: 8px;
    left: 12px;
    font-size: 11px;
    opacity: 0.6;
    max-width: 90%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #waiting {
    color: #555;
    font-size: 14px;
  }
  #img-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100vh;
    padding: 16px;
  }
  #img-container img {
    max-width: 100%;
    max-height: calc(100vh - 40px);
    object-fit: contain;
    border-radius: 4px;
  }
</style>
</head>
<body>
  <div id="status">watching...</div>
  <div id="img-container">
    <div id="waiting">Waiting for vizrender...</div>
  </div>
  <div id="label"></div>
  <script>
    let lastUpdate = 0;
    async function poll() {
      try {
        const resp = await fetch('/api/latest');
        const data = await resp.json();
        if (data.path && data.mtime > lastUpdate) {
          lastUpdate = data.mtime;
          const container = document.getElementById('img-container');
          container.innerHTML = '<img src="/api/image?' + data.mtime + '">';
          document.getElementById('label').textContent = data.source || data.path;
          document.getElementById('status').textContent = 'updated ' + new Date().toLocaleTimeString();
        } else if (!data.path) {
          document.getElementById('status').textContent = 'watching...';
        }
      } catch(e) {
        document.getElementById('status').textContent = 'disconnected';
      }
    }
    setInterval(poll, 500);
    poll();
  </script>
</body>
</html>
"""


class WatchState:
    """Tracks the latest rendered image."""
    def __init__(self, watch_dir):
        self.watch_dir = Path(watch_dir)
        self.watch_dir.mkdir(parents=True, exist_ok=True)
        self.latest_path = None
        self.latest_mtime = 0
        self.source_path = None

    def check(self):
        """Check for new images in watch dir. Returns True if updated."""
        meta_file = self.watch_dir / "latest.json"
        if meta_file.exists():
            try:
                mtime = meta_file.stat().st_mtime
                if mtime > self.latest_mtime:
                    with open(meta_file) as f:
                        data = json.load(f)
                    self.latest_path = data.get("displayed")
                    self.source_path = data.get("source")
                    self.latest_mtime = mtime
                    return True
            except (json.JSONDecodeError, OSError):
                pass
        return False


class Handler(http.server.BaseHTTPRequestHandler):
    state = None

    def do_GET(self):
        if self.path == "/" or self.path == "/index.html":
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(HTML_PAGE.encode())

        elif self.path == "/api/latest":
            self.state.check()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            self.wfile.write(json.dumps({
                "path": self.state.latest_path,
                "source": self.state.source_path,
                "mtime": self.state.latest_mtime,
            }).encode())

        elif self.path.startswith("/api/image"):
            if self.state.latest_path and os.path.exists(self.state.latest_path):
                self.send_response(200)
                self.send_header("Content-Type", "image/png")
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                with open(self.state.latest_path, "rb") as f:
                    self.wfile.write(f.read())
            else:
                self.send_response(404)
                self.end_headers()
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        pass


def run_browser_mode(args):
    """HTTP server + floating browser window."""
    state = WatchState(args.watch_dir)
    Handler.state = state

    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("127.0.0.1", args.port), Handler) as httpd:
        url = f"http://localhost:{args.port}"
        print(f"vizwatch: serving at {url}")
        print(f"vizwatch: watching {args.watch_dir}")

        if not args.no_open:
            try:
                subprocess.Popen([
                    "open", "-na", "Google Chrome", "--args",
                    f"--app={url}",
                    "--window-size=500,400",
                    "--window-position=50,50",
                ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except FileNotFoundError:
                subprocess.Popen(["open", url],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\nvizwatch: stopped")


def run_terminal_mode(args):
    """Poll watch dir and display images in current terminal via vizshow."""
    script_dir = Path(__file__).resolve().parent
    vizshow = script_dir / "vizshow"
    state = WatchState(args.watch_dir)

    print(f"vizwatch: terminal mode — displaying in this pane")
    print(f"vizwatch: watching {args.watch_dir}")
    print(f"vizwatch: waiting for vizrender...\n")

    try:
        while True:
            if state.check() and state.latest_path and os.path.exists(state.latest_path):
                if args.clear:
                    # Clear terminal (works in tmux/zellij panes)
                    print("\033[2J\033[H", end="", flush=True)

                # Display image using vizshow — direct terminal access
                subprocess.run(
                    [str(vizshow), state.latest_path, "--quiet"],
                    check=False,
                )

                # Print source info below image
                source = state.source_path or state.latest_path
                print(f"\033[90m{os.path.basename(source)}\033[0m")

            time.sleep(0.5)
    except KeyboardInterrupt:
        print("\nvizwatch: stopped")


def main():
    parser = argparse.ArgumentParser(description="Image viewer for inline-viz")
    parser.add_argument("--mode", choices=["browser", "terminal"], default="browser",
                        help="browser: floating window (default). terminal: display in current pane (for tmux/zellij)")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT,
                        help="HTTP port for browser mode (default: 52342)")
    parser.add_argument("--watch-dir", type=str, default=str(WATCH_DIR))
    parser.add_argument("--no-open", action="store_true",
                        help="Don't open browser (browser mode only)")
    parser.add_argument("--clear", action="store_true",
                        help="Clear terminal between updates (terminal mode only)")
    args = parser.parse_args()

    if args.mode == "terminal":
        run_terminal_mode(args)
    else:
        run_browser_mode(args)


if __name__ == "__main__":
    main()
