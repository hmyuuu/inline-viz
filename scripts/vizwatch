#!/usr/bin/env python3
"""
vizwatch — floating image viewer for inline-viz.

Starts a tiny HTTP server that serves the latest rendered image with
auto-refresh. Opens in a small browser window that acts as a floating
preview pane. vizrender writes to a watch directory; the browser
auto-updates whenever a new image appears.

Usage:
    vizwatch [--port PORT] [--watch-dir DIR] [--no-open]
"""

import argparse
import http.server
import json
import os
import socketserver
import subprocess
import sys
import threading
import time
from pathlib import Path

WATCH_DIR = Path("/tmp/inline-viz-watch")
DEFAULT_PORT = 52342

HTML_PAGE = """<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>vizwatch</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #1a1a2e;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    font-family: -apple-system, sans-serif;
    color: #8b949e;
    overflow: hidden;
  }
  #status {
    position: fixed;
    top: 8px;
    right: 12px;
    font-size: 11px;
    opacity: 0.6;
  }
  #label {
    position: fixed;
    bottom: 8px;
    left: 12px;
    font-size: 11px;
    opacity: 0.6;
    max-width: 90%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #waiting {
    color: #555;
    font-size: 14px;
  }
  #img-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100vh;
    padding: 16px;
  }
  #img-container img {
    max-width: 100%;
    max-height: calc(100vh - 40px);
    object-fit: contain;
    border-radius: 4px;
  }
</style>
</head>
<body>
  <div id="status">watching...</div>
  <div id="img-container">
    <div id="waiting">Waiting for vizrender...</div>
  </div>
  <div id="label"></div>
  <script>
    let lastUpdate = 0;
    async function poll() {
      try {
        const resp = await fetch('/api/latest');
        const data = await resp.json();
        if (data.path && data.mtime > lastUpdate) {
          lastUpdate = data.mtime;
          const container = document.getElementById('img-container');
          container.innerHTML = '<img src="/api/image?' + data.mtime + '">';
          document.getElementById('label').textContent = data.source || data.path;
          document.getElementById('status').textContent = 'updated ' + new Date().toLocaleTimeString();
        } else if (!data.path) {
          document.getElementById('status').textContent = 'watching...';
        }
      } catch(e) {
        document.getElementById('status').textContent = 'disconnected';
      }
    }
    setInterval(poll, 500);
    poll();
  </script>
</body>
</html>
"""


class WatchState:
    """Tracks the latest rendered image."""
    def __init__(self, watch_dir):
        self.watch_dir = Path(watch_dir)
        self.watch_dir.mkdir(parents=True, exist_ok=True)
        self.latest_path = None
        self.latest_mtime = 0
        self.source_path = None

    def check(self):
        """Check for new images in watch dir."""
        meta_file = self.watch_dir / "latest.json"
        if meta_file.exists():
            try:
                mtime = meta_file.stat().st_mtime
                if mtime > self.latest_mtime:
                    with open(meta_file) as f:
                        data = json.load(f)
                    self.latest_path = data.get("displayed")
                    self.source_path = data.get("source")
                    self.latest_mtime = mtime
            except (json.JSONDecodeError, OSError):
                pass


class Handler(http.server.BaseHTTPRequestHandler):
    state = None

    def do_GET(self):
        if self.path == "/" or self.path == "/index.html":
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(HTML_PAGE.encode())

        elif self.path == "/api/latest":
            self.state.check()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            self.wfile.write(json.dumps({
                "path": self.state.latest_path,
                "source": self.state.source_path,
                "mtime": self.state.latest_mtime,
            }).encode())

        elif self.path.startswith("/api/image"):
            if self.state.latest_path and os.path.exists(self.state.latest_path):
                self.send_response(200)
                self.send_header("Content-Type", "image/png")
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                with open(self.state.latest_path, "rb") as f:
                    self.wfile.write(f.read())
            else:
                self.send_response(404)
                self.end_headers()
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        pass  # silence logs


def main():
    parser = argparse.ArgumentParser(description="Floating image viewer for inline-viz")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    parser.add_argument("--watch-dir", type=str, default=str(WATCH_DIR))
    parser.add_argument("--no-open", action="store_true", help="Don't open browser")
    args = parser.parse_args()

    state = WatchState(args.watch_dir)
    Handler.state = state

    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("127.0.0.1", args.port), Handler) as httpd:
        url = f"http://localhost:{args.port}"
        print(f"vizwatch: serving at {url}")
        print(f"vizwatch: watching {args.watch_dir}")

        if not args.no_open:
            # Try Chrome app mode (floating window), fall back to default browser
            try:
                subprocess.Popen([
                    "open", "-na", "Google Chrome", "--args",
                    f"--app={url}",
                    "--window-size=500,400",
                    "--window-position=50,50",
                ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except FileNotFoundError:
                subprocess.Popen(["open", url],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\nvizwatch: stopped")


if __name__ == "__main__":
    main()
