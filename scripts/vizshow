#!/usr/bin/env bash
# vizshow — Display an image inline in the terminal
# Part of inline-viz (Layer 1)
#
# Usage: vizshow <image-file> [--width N] [--protocol P] [--quiet]
#
# Exit codes: 0=displayed, 1=error, 2=fallback (e.g. --protocol file)

set -euo pipefail

# ── Defaults ──────────────────────────────────────────────────────────────
FILE=""
WIDTH=""
PROTOCOL=""
QUIET=false

# ── Argument parsing ─────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --width)   WIDTH="$2";    shift 2 ;;
    --protocol) PROTOCOL="$2"; shift 2 ;;
    --quiet)   QUIET=true;    shift   ;;
    -*)
      echo "vizshow: unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$FILE" ]]; then
        FILE="$1"
      else
        echo "vizshow: unexpected argument: $1" >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [[ -z "$FILE" ]]; then
  echo "vizshow: no file specified" >&2
  exit 1
fi

# ── Validate file ────────────────────────────────────────────────────────
if [[ ! -f "$FILE" ]]; then
  echo "vizshow: not found: $FILE" >&2
  exit 1
fi

# ── Resolve absolute path ────────────────────────────────────────────────
ABS_PATH="$(cd "$(dirname "$FILE")" && pwd)/$(basename "$FILE")"

# ── Terminal width ────────────────────────────────────────────────────────
TERM_WIDTH="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
DISPLAY_WIDTH="${WIDTH:-$TERM_WIDTH}"

# ── Protocol detection ───────────────────────────────────────────────────
detect_protocol() {
  if [[ "${TERM_PROGRAM:-}" == "iTerm.app" ]]; then
    echo "iterm2"
  elif [[ -n "${KITTY_PID:-}" ]]; then
    echo "kitty"
  elif [[ -n "${GHOSTTY_RESOURCES_DIR:-}" ]]; then
    echo "kitty"
  elif [[ -n "${WEZTERM_EXECUTABLE:-}" ]]; then
    echo "iterm2"
  elif command -v timg &>/dev/null; then
    echo "timg"
  elif command -v chafa &>/dev/null; then
    echo "chafa"
  elif command -v imgcat &>/dev/null; then
    echo "imgcat"
  elif command -v kitten &>/dev/null; then
    echo "kitten"
  else
    echo "fallback"
  fi
}

PROTO="${PROTOCOL:-$(detect_protocol)}"

# ── tmux passthrough ─────────────────────────────────────────────────────
# When inside tmux, escape sequences must be wrapped in DCS passthrough
# so they reach the outer terminal. Requires: set -g allow-passthrough on
IN_TMUX=false
[[ -n "${TMUX:-}" ]] && IN_TMUX=true

tmux_wrap_start() {
  [[ "$IN_TMUX" == true ]] && printf '\033Ptmux;\033'
}
tmux_wrap_end() {
  [[ "$IN_TMUX" == true ]] && printf '\033\\'
}

# ── Display functions ────────────────────────────────────────────────────

display_iterm2() {
  local data
  data="$(base64 < "$ABS_PATH")"
  tmux_wrap_start
  printf '\033]1337;File=inline=1;width=%s:' "$DISPLAY_WIDTH"
  printf '%s' "$data"
  printf '\a'
  tmux_wrap_end
}

display_kitty() {
  # Kitty graphics protocol: chunked base64 PNG transfer
  local data chunk
  data="$(base64 < "$ABS_PATH")"
  local len=${#data}
  local pos=0
  local chunk_size=4096
  local first=1
  while [[ $pos -lt $len ]]; do
    chunk="${data:$pos:$chunk_size}"
    pos=$((pos + chunk_size))
    if [[ $first -eq 1 ]]; then
      first=0
      if [[ $pos -ge $len ]]; then
        tmux_wrap_start
        printf '\033_Ga=T,f=100,q=2;%s\033\\' "$chunk"
        tmux_wrap_end
      else
        tmux_wrap_start
        printf '\033_Ga=T,f=100,m=1,q=2;%s\033\\' "$chunk"
        tmux_wrap_end
      fi
    else
      if [[ $pos -ge $len ]]; then
        tmux_wrap_start
        printf '\033_Gm=0;%s\033\\' "$chunk"
        tmux_wrap_end
      else
        tmux_wrap_start
        printf '\033_Gm=1;%s\033\\' "$chunk"
        tmux_wrap_end
      fi
    fi
  done
  echo ""
}

display_timg() {
  timg -W "$DISPLAY_WIDTH" "$ABS_PATH"
}

display_chafa() {
  chafa --size "${DISPLAY_WIDTH}x" "$ABS_PATH"
}

display_imgcat() {
  imgcat "$ABS_PATH"
}

display_kitten() {
  kitten icat "$ABS_PATH"
}

display_fallback() {
  echo "[vizshow: fallback — no display method available for $ABS_PATH]" >&2
}

# ── Handle --protocol file (always exit 2) ───────────────────────────────
if [[ "$PROTO" == "file" ]]; then
  if [[ "$QUIET" != true ]]; then
    echo "[vizshow: $ABS_PATH via file]"
  fi
  exit 2
fi

# ── Display ──────────────────────────────────────────────────────────────
case "$PROTO" in
  iterm2)   display_iterm2   ;;
  kitty)    display_kitty    ;;
  timg)     display_timg     ;;
  chafa)    display_chafa    ;;
  imgcat)   display_imgcat   ;;
  kitten)   display_kitten   ;;
  fallback) display_fallback ;;
  *)
    echo "vizshow: unknown protocol: $PROTO" >&2
    exit 1
    ;;
esac

# ── Tag line ─────────────────────────────────────────────────────────────
if [[ "$QUIET" != true ]]; then
  echo "[vizshow: $ABS_PATH via $PROTO]"
fi

exit 0
